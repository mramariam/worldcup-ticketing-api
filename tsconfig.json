{
  "compilerOptions": {
    "experimentalDecorators": true, 
    "emitDecoratorMetadata": true,
    "types": ["bun","node"],
    "paths": {
      "@domain/*": [
        "./src/domain/*"
      ],
      "@application/*": [
        "./src/application/*"
      ],
      "@infrastructure/*":[
        "./src/infrastructure/*"
      ],
    },
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}